# ---------------------------------------------------------------------------
# Modelo de configuração. Copie para .env antes de subir o ambiente:
#     cp .env.example .env
# O arquivo .env não é versionado, pois guarda segredos reais.
# ---------------------------------------------------------------------------

# --- Banco de dados (PostgreSQL) -------------------------------------------
POSTGRES_USER=exchange
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=exchange

# URL de conexão usada pela API e pelo Alembic.
# O host "postgres" é o nome do serviço dentro da rede do Docker Compose.
DATABASE_URL=postgresql+psycopg://exchange:troque-esta-senha@postgres:5432/exchange

# --- Object storage (MinIO) ------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=troque-esta-senha-tambem

# Endpoint interno, sem esquema (o cliente MinIO monta o esquema a partir de
# STORAGE_SECURE). "minio" é o nome do serviço no Compose.
STORAGE_ENDPOINT=minio:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=troque-esta-senha-tambem
STORAGE_BUCKET=ciphertexts
STORAGE_SECURE=false

# --- Portas expostas no host ------------------------------------------------
# Ajuste se algo já ocupar estas portas na sua máquina.
#
# Em um servidor onde as portas 80 e 443 pertencem a outro Nginx, use portas
# altas e suba com o docker-compose.prod.yml, que as prende ao loopback:
#     HTTPS_PORT=8443
#     MINIO_CONSOLE_PORT=9002
HTTP_PORT=80
HTTPS_PORT=443
MINIO_CONSOLE_PORT=9001

# --- Regras de negócio -----------------------------------------------------
# Limite de tamanho da CIFRA aceita pela API, em bytes.
# O plano fixa 100 MB por arquivo original; como o AES-GCM acrescenta 16 bytes
# de etiqueta de autenticidade, a cifra correspondente tem 100 MiB + 16 bytes.
MAX_UPLOAD_BYTES=104857616

# Tempo de vida de cada arquivo, em horas.
FILE_TTL_HOURS=24
